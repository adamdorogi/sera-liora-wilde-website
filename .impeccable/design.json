  "narrative": {
    "northStar": "The Sunroom",
    "overview": "A welcoming window onto independent local care. The approved image-first direction pairs generous near-white space with pine green, pale celery and soft rose. Elegant Roman serif headings and plain sans text make the collective feel personal and useful.\n\nSource photography supplies the people and places. Arches give larger photographs a gentle architectural frame; the directory gives each practitioner the same clear portrait, name, role and next step. The approved composition is recorded in `.impeccable/surfaces/app-page-tsx.md`; it does not prescribe the composition of every future page.",
    "keyCharacteristics": [
      "Human photography with deliberate crops.",
      "Spacious editorial sections and a flat directory.",
      "Real lowercase and italic serif lettering.",
      "Small pill controls with explicit interaction states."
    ],
    "rules": [
      {
        "name": "The Typeface Fidelity Rule",
        "body": "Use the supplied regular and italic Baskervville faces so lowercase and italic letters remain intact; do not substitute a small-caps display face.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use approved source photographs for people and places, with deliberate crops.",
      "**Do** preserve the local Baskervville regular and italic lettering.",
